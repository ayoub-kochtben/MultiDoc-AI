# Copier en .env pour surcharger les valeurs par défaut.
# Base de données : vide = PostgreSQL 16 + pgvector embarqué (pgserver), données dans data/pgdata.
# Pour un PostgreSQL externe (avec pgvector) : DATABASE_URL=postgresql+psycopg://user:pass@host:5432/multidoc
DATABASE_URL=
OLLAMA_URL=http://localhost:11434
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_QUANTIZE=true
OCR_LANGUAGES=fra+eng
PDF_ENGINE=docling
MAX_UPLOAD_MB=200
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
